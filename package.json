{
  "name": "sns-assets",
  "version": "0.1.0",
  "description": "TypeScript library to scan neurons and token balances across all Dfinity SNS projects",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "format": "prettier --write .",
    "update-snapshot": "node scripts/update-snapshot.mjs"
  },
  "keywords": [
    "dfinity",
    "sns",
    "icp",
    "neurons",
    "governance",
    "icrc"
  ],
  "license": "MIT",
  "dependencies": {
    "@dfinity/agent": "^2.1.3",
    "@dfinity/candid": "^2.1.3",
    "@dfinity/ledger-icrc": "^2.7.0",
    "@dfinity/principal": "^2.1.3",
    "@dfinity/sns": "^3.5.0",
    "@dfinity/utils": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^5.4.0",
    "vite-plugin-dts": "^4.5.0"
  }
}
